# Per-user Kite + Telegram credentials for %%USER_SLUG%%
# Lives at %%DATA_DIR%%/.env  (chmod 600, never committed)

# Required: Kite Connect (developers.kite.trade)
API_KEY=
API_SECRET=
ACCESS_TOKEN=

# Optional: auto-refresh (TOTP login from Kite web)
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Optional: Telegram alerts (each user gets their own bot/chat)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Admin / onboarding — set to true ONLY on the primary instance that should
# be able to invite new users via the UI. Other instances must leave this off.
ADMIN_ENABLED=false
# Hard cap on total provisioned users (default 10; AWS SG ports 8001-8010).
ADMIN_MAX_USERS=10
