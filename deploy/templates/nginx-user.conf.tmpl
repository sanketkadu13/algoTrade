# Per-user nginx server block for the kite dashboard.
# Each user gets their own listen port + their own basic-auth file.
# Routes incoming traffic on PUBLIC_PORT → Flask on FLASK_PORT (localhost only).

server {
    listen %%PUBLIC_PORT%%;
    server_name _;

    auth_basic           "Kite Monitor — %%USER_SLUG%%";
    auth_basic_user_file /etc/nginx/.htpasswd-%%USER_SLUG%%;

    # /logout — bypass basic-auth so Flask can return its 401 with a rotated
    # realm string, which invalidates the browser's cached creds.
    location = /logout {
        auth_basic off;
        proxy_pass         http://127.0.0.1:%%FLASK_PORT%%;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
    }

    # Static assets (favicon, future css/images) — public; needed pre-auth.
    location /static/ {
        auth_basic off;
        proxy_pass         http://127.0.0.1:%%FLASK_PORT%%;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
    }
    location = /favicon.ico {
        auth_basic off;
        proxy_pass         http://127.0.0.1:%%FLASK_PORT%%;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
    }

    # SSE-friendly proxy to this user's Flask app on localhost
    location / {
        proxy_pass         http://127.0.0.1:%%FLASK_PORT%%;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";

        # SSE: no buffering, long timeouts, no caching
        proxy_buffering     off;
        proxy_cache         off;
        proxy_read_timeout  24h;
        proxy_send_timeout  24h;
        gzip                off;
    }
}
