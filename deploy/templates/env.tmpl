# Kite + Telegram credentials for this instance.
# Lives at $DATA_DIR/.env  (chmod 600, never committed).

# Required: Kite Connect (developers.kite.trade)
API_KEY=
API_SECRET=
ACCESS_TOKEN=

# Optional: auto-refresh (TOTP login from Kite web)
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Optional: Telegram alerts (configurable from UI under the "Alerts" tab)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
